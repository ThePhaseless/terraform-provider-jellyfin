{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  // The repo also allows merge commits, which "auto" could pick.
  "automergeStrategy": "squash",
  "prConcurrentLimit": 20,
  // tools/go.mod reaches tools/copywrite-patched through a local replace. A
  // bump inside the fork must also tidy tools/, or `make generate` refuses to
  // run.
  "postUpdateOptions": ["gomodTidyAll"],
  // Security fixes for indirect modules too, as Dependabot raises them.
  "osvVulnerabilityAlerts": true,
  "customDatasources": {
    // Jellyfin installs a plugin by the four-segment version in its manifest,
    // which the three-segment release tags do not carry.
    "jellyfin-security-manifest": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/ZL154/JellyfinSecurity/main/manifest.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$[0].versions.{\"version\": version}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/provider/supported_security_plugin_version\\.env$/"],
      "matchStrings": ["SECURITY_PLUGIN_VERSION=(?<currentValue>.+?)\\s"],
      "depNameTemplate": "JellyfinSecurity",
      "datasourceTemplate": "custom.jellyfin-security-manifest",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/provider/supported_jellyfin_version\\.env$/"],
      "matchStrings": ["JELLYFIN_VERSION=(?<currentValue>.+?)\\s"],
      "depNameTemplate": "jellyfin/jellyfin",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      // CI is the gate. Majors stay manual.
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      // Renovate skips `// indirect` Go modules by default. One grouped PR
      // keeps them current, including fixes such as grpc's.
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true,
      "groupName": "indirect Go modules"
    },
    {
      // A major Go version is a new module path. Nothing imports the new path
      // of an indirect module, so `go mod tidy` drops it and the bump never
      // builds.
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // A patched fork of hashicorp/copywrite. Following its dependencies past
      // upstream's majors only widens the diff it carries.
      "matchFileNames": ["tools/copywrite-patched/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // gomodTidyAll rewrites tools/go.mod when the fork changes. On a branch
      // that also updates tools/go.mod, one pass's go.mod lands beside the
      // other's go.sum and `make generate` fails on the missing sums.
      "matchFileNames": ["tools/copywrite-patched/**"],
      "additionalBranchPrefix": "copywrite-patched-",
      "commitMessageSuffix": "in the copywrite fork"
    },
    {
      // Majors automerge too: schema-check.yaml fails the PR when the plugin's
      // public config properties change. The manifest lists each release twice,
      // .0 for the Jellyfin 10.11 ABI and .1 for 12.x, which CI runs.
      "matchPackageNames": ["JellyfinSecurity"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+\\.1$/",
      "commitMessagePrefix": "chore:",
      "commitMessageTopic": "JellyfinSecurity plugin version",
      "automerge": true
    },
    {
      // Majors automerge too: the acceptance suite boots this Jellyfin version.
      "matchPackageNames": ["jellyfin/jellyfin"],
      "commitMessagePrefix": "chore:",
      "commitMessageTopic": "Jellyfin server version",
      "automerge": true
    }
  ]
}
