{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  // Renovate merges the PR itself: the repo has allow_auto_merge off and no
  // branch protection, so GitHub's auto-merge button does not exist.
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "prConcurrentLimit": 20,
  "postUpdateOptions": ["gomodTidy"],
  // github-releases would yield the three-segment tag; Jellyfin resolves an
  // install against manifest.json, which carries four-segment assembly
  // versions. Read the manifest directly so the stored value is installable.
  "customDatasources": {
    "jellyfin-security-manifest": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/ZL154/JellyfinSecurity/main/manifest.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$[0].versions.{\"version\": version}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/provider/supported_security_plugin_version\\.env$/"],
      "matchStrings": ["SECURITY_PLUGIN_VERSION=(?<currentValue>.+?)\\s"],
      "depNameTemplate": "JellyfinSecurity",
      "datasourceTemplate": "custom.jellyfin-security-manifest",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^internal/provider/supported_jellyfin_version\\.env$/"],
      "matchStrings": ["JELLYFIN_VERSION=(?<currentValue>.+?)\\s"],
      "depNameTemplate": "jellyfin/jellyfin",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Stay current on its own; CI is the gate.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "Majors are breaking by definition.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      // A fork of hashicorp/copywrite, patched and pinned. Following its
      // dependencies past what upstream pins only widens the diff it carries.
      "description": "No major bumps inside the vendored copywrite fork.",
      "matchFileNames": ["tools/copywrite-patched/**"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      // Safe to automerge because schema-check.yaml fails the PR when the
      // plugin's public config properties changed across the bump.
      "matchPackageNames": ["JellyfinSecurity"],
      "commitMessagePrefix": "chore:",
      "commitMessageTopic": "JellyfinSecurity plugin version",
      "automerge": true
    },
    {
      // Gated by the acceptance suite, which boots this Jellyfin version.
      "matchPackageNames": ["jellyfin/jellyfin"],
      "commitMessagePrefix": "chore:",
      "commitMessageTopic": "Jellyfin server version",
      "automerge": true
    }
  ]
}
